#N canvas 140 100 780 600 12;
#X text 20 10 fs_device <name> <MAC> - one per sensor. Receives this MAC's traffic from [fs_net] and re-sends each channel to fs-<name>-<channel> so [fs_in <name> <channel>] taps can pick it up. Gesture triggers arrive as fs-<name>-gesture/<label>. The Pi's __advertise__ list is printed to the console and re-sent on fs-<name>-advertise., f 92;
#X obj 20 110 r fs-dev-\$2;
#X obj 20 140 list trim;
#X obj 20 180 route gesture __advertise__;
#X obj 380 230 list split 1;
#X obj 380 330 list;
#X obj 430 260 t b a;
#X obj 480 290 list prepend \$1;
#X msg 480 320 symbol fs-\$1-\$2;
#X obj 380 370 s;
#X obj 20 230 list split 1;
#X obj 20 330 list;
#X obj 70 260 t b a;
#X obj 120 290 list prepend \$1;
#X msg 120 320 symbol fs-\$1-gesture/\$2;
#X obj 20 370 s;
#X obj 200 440 s fs-\$1-advertise;
#X obj 200 470 print fs-\$1-advertise;
#X obj 600 140 outlet;
#X text 600 170 every message for this device (debug), f 20;
#X text 20 410 gesture/<label>;
#X text 200 410 advertise;
#X text 380 410 all other channels;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 2 0 18 0;
#X connect 3 0 10 0;
#X connect 3 1 16 0;
#X connect 3 1 17 0;
#X connect 3 2 4 0;
#X connect 4 1 5 1;
#X connect 4 0 6 0;
#X connect 6 1 7 0;
#X connect 7 0 8 0;
#X connect 8 0 9 1;
#X connect 6 0 5 0;
#X connect 5 0 9 0;
#X connect 10 1 11 1;
#X connect 10 0 12 0;
#X connect 12 1 13 0;
#X connect 13 0 14 0;
#X connect 14 0 15 1;
#X connect 12 0 11 0;
#X connect 11 0 15 0;
