#N canvas 80 80 900 600 12;
#X declare -path ..;
#X text 20 10 Headless smoke test for fs_drone / fs_pluck / fs_hit: each output goes through env~ and prints 1 when audible (> -60 dBFS) and 0 when silent again. Driven by: python tools/pdtest.py run instruments --log <file>., f 110;
#X obj 20 70 fs_net 12360;
#X obj 160 70 fs_device t1 AA:BB:CC:DD:EE:01;
#X obj 20 130 fs_drone t1 45;
#X obj 20 160 env~;
#X obj 20 190 > 40;
#X obj 20 220 change;
#X obj 20 250 print drone;
#X obj 220 130 fs_pluck t1 57;
#X obj 220 160 env~;
#X obj 220 190 > 40;
#X obj 220 220 change;
#X obj 220 250 print pluck;
#X obj 420 130 fs_hit t1 roll 300;
#X obj 420 160 env~;
#X obj 420 190 > 40;
#X obj 420 220 change;
#X obj 420 250 print hit;
#X obj 20 320 r fs-dev-test;
#X obj 20 350 list trim;
#X obj 20 380 route quit mark;
#X obj 20 410 t b b;
#X obj 120 440 print DONE;
#X msg 20 480 \; pd quit;
#X obj 400 320 loadbang;
#X obj 400 350 t b b b;
#X obj 400 480 print READY;
#X obj 480 410 delay 40000;
#X msg 560 380 \; pd dsp 1;
#X obj 600 70 declare -path ..;
#X obj 620 130 fs_drone_point t1 45;
#X obj 620 160 env~;
#X obj 620 190 > 40;
#X obj 620 220 change;
#X obj 620 250 print dronep;
#X obj 800 130 fs_pluck_point t1 57;
#X obj 800 160 env~;
#X obj 800 190 > 40;
#X obj 800 220 change;
#X obj 800 250 print pluckp;
#X obj 20 530 fs_sphere t1 57 61 64 66 69 71 73 76 81;
#X obj 20 560 env~;
#X obj 20 590 > 40;
#X obj 20 620 change;
#X obj 20 650 print sphere;
#X obj 200 410 print MARK;
