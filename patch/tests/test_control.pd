#X text 20 10 Headless test for fs_map / fs_onset / fs_quantize. Driven by: python tools/pdtest.py run control --log <file>. Values arrive as /test/<route> <value>., f 100;
#X obj 20 70 r fs-dev-test;
#X obj 20 100 list trim;
#X obj 20 130 route quit map map_inv onset quant qscale smooth tune smooth_rel;
