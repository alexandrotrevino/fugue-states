#N canvas 120 60 1100 620 12;
#X text 20 10 fs_partials <midi> - additive voice for one sphere point. Left inlet (hot): level 0..1 (how closely you point at it \, already smoothed and gated) - brings in the fundamental. Middle inlet (cold): energy 0..1 (how much you are moving). Right inlet: new MIDI note. Harmonics 2..5 are recruited one by one as level x (0.4 + energy) rises: point gently = pure tone \, point dead-on while moving = full spectrum. Harmonic k is scaled 1/k., f 120;
#X obj 20 110 inlet;
#X obj 400 110 inlet;
#X obj 950 110 inlet;
#X obj 20 150 expr $f1 \; $f1 * min(max(min(max($f1 * (0.4 + $f2) \, 0) \, 1) * 4 - 0 \, 0) \, 1) / 2 \; $f1 * min(max(min(max($f1 * (0.4 + $f2) \, 0) \, 1) * 4 - 1 \, 0) \, 1) / 3 \; $f1 * min(max(min(max($f1 * (0.4 + $f2) \, 0) \, 1) * 4 - 2 \, 0) \, 1) / 4 \; $f1 * min(max(min(max($f1 * (0.4 + $f2) \, 0) \, 1) * 4 - 3 \, 0) \, 1) / 5;
#X obj 800 110 loadbang;
#X obj 800 140 f \$1;
#X obj 800 170 mtof;
#X obj 800 200 t f f f f f;
#X obj 20 500 *~ 0.12;
#X obj 20 540 outlet~;
#X obj 20 260 pack f 30;
#X obj 20 290 line~;
#X obj 20 420 *~;
