#N canvas 120 60 900 420 12;
#X text 20 10 fs_smooth <attack_ms> <release_ms> - asymmetric smoother with time constants in milliseconds: a rising input is followed with time constant attack_ms \, a falling one with release_ms. Uses the real time between incoming values ([timer]) \, so it behaves the same at any sensor rate. Only advances when values arrive. Inlet 2: attack_ms \, inlet 3: release_ms (change live)., f 110;
#X obj 20 110 inlet;
#X obj 500 110 inlet;
#X obj 650 110 inlet;
#X obj 20 140 t f b;
#X obj 120 170 t b b;
#X obj 120 210 timer;
#X obj 20 260 expr if($f1 > $f2 \, $f2 + (1 - exp(-$f3 / max($f4 \, 0.001))) * ($f1 - $f2) \, $f2 + (1 - exp(-$f3 / max($f5 \, 0.001))) * ($f1 - $f2));
#X obj 20 300 t f f;
#X obj 20 340 outlet;
#X obj 500 150 loadbang;
#X obj 500 180 f \$1;
#X obj 650 180 f \$2;
#X connect 1 0 4 0;
#X connect 4 1 5 0;
#X connect 5 1 6 1;
#X connect 5 0 6 0;
#X connect 6 0 7 2;
#X connect 4 0 7 0;
#X connect 7 0 8 0;
#X connect 8 1 7 1;
#X connect 8 0 9 0;
#X connect 10 0 11 0;
#X connect 10 0 12 0;
#X connect 11 0 7 3;
#X connect 12 0 7 4;
#X connect 2 0 7 3;
#X connect 3 0 7 4;
