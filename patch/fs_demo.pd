#N canvas 60 60 900 640 12;
#X text 20 10 FS receiver demo - open this \, then from the repo root run: python tools/replay_osc.py --synthetic (or a recording: python tools/replay_osc.py recordings/gesture-wave-20260503T214637.jsonl --loop). With the Pi live \, point its OSC target at this machine instead., f 110;
#X obj 20 80 fs_net 12345;
#X floatatom 120 120 7 0 0 0 - - - 0;
#X text 190 120 msg/s, f 6;
#X obj 20 170 fs_device mmrl E0:2D:64:47:02:F5;
#X obj 460 170 fs_device mms EC:47:49:CF:53:C4;
#X text 20 220 mmrl, f 5;
#X obj 20 250 fs_in mmrl acc_mag;
#X obj 20 280 hsl 160 18 0 3 0 0 empty empty acc_mag 0 -9 0 10 #fcfcfc #000000 #000000 0 1;
#X obj 20 330 fs_in mmrl tilt;
#X obj 20 360 hsl 160 18 0 180 0 0 empty empty tilt 0 -9 0 10 #fcfcfc #000000 #000000 0 1;
#X obj 20 410 fs_in mmrl acc;
#X obj 20 440 unpack f f f;
#X floatatom 20 470 6 0 0 0 - - - 0;
#X floatatom 80 470 6 0 0 0 - - - 0;
#X floatatom 140 470 6 0 0 0 - - - 0;
#X obj 20 520 fs_in mmrl gesture/roll;
#X obj 220 520 fs_in mmrl gesture/chop;
#X floatatom 20 550 6 0 0 0 - - - 0;
#X floatatom 220 550 6 0 0 0 - - - 0;
#X text 460 220 mms, f 5;
#X obj 460 250 fs_in mms acc_mag;
#X obj 460 280 hsl 160 18 0 3 0 0 empty empty acc_mag 0 -9 0 10 #fcfcfc #000000 #000000 0 1;
#X obj 460 330 fs_in mms tilt;
#X obj 460 360 hsl 160 18 0 180 0 0 empty empty tilt 0 -9 0 10 #fcfcfc #000000 #000000 0 1;
#X obj 460 410 fs_in mms gyro_mag;
#X obj 460 440 hsl 160 18 0 500 0 0 empty empty gyro_mag 0 -9 0 10 #fcfcfc #000000 #000000 0 1;
#X obj 460 520 fs_in mms gesture/roll;
#X obj 660 520 fs_in mms gesture/chop;
#X floatatom 460 550 6 0 0 0 - - - 0;
#X floatatom 660 550 6 0 0 0 - - - 0;
#X text 20 590 gesture boxes show the confidence of the last trigger (synthetic mode fires one every 5-12 s), f 100;
