#N canvas 120 60 1200 520 12;
#X text 20 10 fs_sphere <name> <n1> ... <n9> - the alignment sphere for a sensor-fusion sensor whose Pi pipeline runs Orientation + Alignment (dome9 layout: 8 points in a ring just above the horizon + 1 straight up). Each point plays MIDI note n1..n9 (ring order counterclockwise from front \, then the zenith). Point at a note to bring it in \; point dead-on and move (corrected_gyro_mag 30..600 deg/s) to recruit its overtones. Leaving a point lets it ring out (fs_smooth 0.5 0.06). Let your arm hang for silence., f 140;
#X obj 20 120 fs_in \$1 sphere;
#X obj 20 150 unpack f f f f f f f f f;
#X obj 800 120 fs_in \$1 corrected_gyro_mag;
#X obj 800 150 fs_map 30 600 0 1;
#X obj 20 440 outlet~;
#X obj 20 220 fs_smooth 0.5 0.06;
#X obj 20 320 fs_partials \$2;
#X obj 145 250 fs_smooth 0.5 0.06;
#X obj 145 350 fs_partials \$3;
#X obj 270 220 fs_smooth 0.5 0.06;
#X obj 270 320 fs_partials \$4;
#X obj 395 250 fs_smooth 0.5 0.06;
#X obj 395 350 fs_partials \$5;
#X obj 520 220 fs_smooth 0.5 0.06;
#X obj 520 320 fs_partials \$6;
#X obj 645 250 fs_smooth 0.5 0.06;
#X obj 645 350 fs_partials \$7;
#X obj 770 220 fs_smooth 0.5 0.06;
#X obj 770 320 fs_partials \$8;
#X obj 895 250 fs_smooth 0.5 0.06;
#X obj 895 350 fs_partials \$9;
#X obj 1020 220 fs_smooth 0.5 0.06;
#X obj 1020 320 fs_partials \$10;
