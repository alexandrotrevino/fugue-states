#N canvas 120 60 900 720 12;
#X text 20 10 fs_pluck <name> <root_midi> - tilt chooses the note (scale over 2 octaves from root) \; a sharp flick (acc_mag crossing 2 g \, re-arm below 1.3 g \, 120 ms refractory) plays it. Harder flick = louder (2..4 g -> 0.3..1). Three harmonics \, 700 ms decay \, monophonic. Inlet: scale messages., f 110;
#X obj 20 120 fs_in \$1 tilt;
#X obj 20 150 fs_map 10 150 0 1;
#X obj 20 180 fs_quantize \$2 2;
#X obj 280 260 f;
#X obj 280 120 fs_in \$1 acc_mag;
#X obj 280 150 fs_onset 2 1.3 120;
#X obj 280 180 fs_map 2 4 0.3 1;
#X obj 280 220 t f b;
#X obj 280 290 mtof;
#X obj 280 320 t f f f;
#X obj 280 370 osc~;
#X obj 380 350 * 2;
#X obj 380 380 osc~;
#X obj 480 350 * 3;
#X obj 480 380 osc~;
#X obj 380 410 *~ 0.4;
#X obj 480 410 *~ 0.15;
#X obj 280 450 +~;
#X obj 280 480 +~;
#X msg 600 260 \$1 3 \, 0 700 3;
#X obj 600 300 vline~;
#X obj 600 340 *~;
#X obj 280 540 *~;
#X obj 280 580 *~ 0.3;
#X obj 280 620 outlet~;
#X obj 160 120 inlet;
#X text 20 260 current note (cold), f 20;
#X text 600 370 envelope (squared), f 18;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 3 0 4 1;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 8 1 4 0;
#X connect 4 0 9 0;
#X connect 9 0 10 0;
#X connect 10 0 11 0;
#X connect 10 1 12 0;
#X connect 12 0 13 0;
#X connect 10 2 14 0;
#X connect 14 0 15 0;
#X connect 13 0 16 0;
#X connect 15 0 17 0;
#X connect 11 0 18 0;
#X connect 16 0 18 1;
#X connect 18 0 19 0;
#X connect 17 0 19 1;
#X connect 19 0 23 0;
#X connect 8 0 20 0;
#X connect 20 0 21 0;
#X connect 21 0 22 0;
#X connect 21 0 22 1;
#X connect 22 0 23 1;
#X connect 23 0 24 0;
#X connect 24 0 25 0;
