#N canvas 120 80 760 620 12;
#X text 20 10 fs_net [port] - single entry point for FS OSC traffic. Listens on [port] (default 12345) and re-sends every /<MAC>/<channel> message to the receive name fs-dev-<MAC>. Declare one [fs_device <name> <MAC>] per sensor to fan those out to [fs_in] taps. Non-device traffic (/state/... /error/... /indicator/...) lands on fs-dev-state / fs-dev-error etc. for future status objects., f 92;
#X obj 20 120 loadbang;
#X obj 20 150 f \$1;
#X obj 20 180 moses 1;
#X msg 20 210 12345;
#X msg 20 245 listen \$1;
#X obj 20 280 netreceive -u -b;
#X obj 20 310 oscparse;
#X obj 20 340 list trim;
#X obj 20 400 list split 1;
#X obj 20 500 list;
#X obj 70 430 t b a;
#X msg 120 460 symbol fs-dev-\$1;
#X obj 20 540 s;
#X obj 120 120 inlet;
#X obj 300 560 outlet;
#X obj 500 560 outlet;
#X obj 500 370 t b;
#X obj 500 410 f;
#X obj 550 410 + 1;
#X obj 600 300 metro 1000;
#X obj 600 330 t b b;
#X obj 500 520 f;
#X msg 640 370 0;
#X text 300 590 parsed messages, f 16;
#X text 500 590 messages/sec, f 13;
#X text 160 120 inlet: port (re-listen), f 24;
#X connect 1 0 2 0;
#X connect 1 0 20 0;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 3 1 5 0;
#X connect 4 0 5 0;
#X connect 14 0 3 0;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 8 0 15 0;
#X connect 8 0 17 0;
#X connect 9 1 10 1;
#X connect 9 0 11 0;
#X connect 11 1 12 0;
#X connect 12 0 13 1;
#X connect 11 0 10 0;
#X connect 10 0 13 0;
#X connect 17 0 18 0;
#X connect 18 0 19 0;
#X connect 19 0 18 1;
#X connect 19 0 22 1;
#X connect 20 0 21 0;
#X connect 21 1 22 0;
#X connect 21 0 23 0;
