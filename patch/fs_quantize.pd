#N canvas 200 100 820 640 12;
#X text 20 10 fs_quantize <root_midi> <octaves> - maps 0..1 onto the notes of a scale spanning <octaves> octaves upward from root and outputs a MIDI note. Default scale is major pentatonic (0 2 4 7 9: no wrong notes). Send "scale 0 2 3 5 7 8 10" etc. to change it (up to 12 degrees)., f 90;
#X obj 20 100 inlet;
#X obj 20 140 route scale;
#X obj 20 190 expr int(min(max($f1 \, 0) \, 0.9999) * $f2 * \$2);
#X obj 20 230 t f f;
#X obj 140 270 div 5;
#X obj 140 300 * 12;
#X obj 140 330 + \$1;
#X obj 20 330 mod 5;
#X obj 20 370 tabread \$0-scale;
#X obj 20 410 +;
#X obj 20 450 outlet;
#X obj 400 190 t a a;
#X obj 460 230 list length;
#X obj 400 270 list prepend 0;
#X obj 400 300 s \$0-scale;
#X obj 400 100 loadbang;
#X msg 400 140 scale 0 2 4 7 9;
#X obj 560 400 array define \$0-scale 12;
#X text 230 330 octave offset (cold), f 21;
#X text 520 230 scale length -> step count \, mod \, div, f 26;
#X connect 1 0 2 0;
#X connect 2 0 12 0;
#X connect 2 1 3 0;
#X connect 3 0 4 0;
#X connect 4 1 5 0;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 7 0 10 1;
#X connect 4 0 8 0;
#X connect 8 0 9 0;
#X connect 9 0 10 0;
#X connect 10 0 11 0;
#X connect 12 1 13 0;
#X connect 13 0 3 1;
#X connect 13 0 5 1;
#X connect 13 0 8 1;
#X connect 12 0 14 0;
#X connect 14 0 15 0;
#X connect 16 0 17 0;
#X connect 17 0 2 0;
