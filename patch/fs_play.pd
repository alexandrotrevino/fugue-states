#N canvas 40 40 1000 700 12;
#X text 20 10 FS play - first instruments. Turn DSP on \, then move. mmrl: tilt-pitched drone that swells when you rotate \, flick-to-pluck (tilt picks the note) \, and percussive hits on roll / chop / wave gestures (needs run_fs.py --gesture-library). mms: a second drone and pluck a third up. To try it without the Pi: python tools/replay_osc.py --synthetic, f 130;
#X obj 20 90 fs_net 12345;
#X floatatom 120 120 7 0 0 0 - - - 0;
#X obj 20 160 fs_device mmrl E0:2D:64:47:02:F5;
#X obj 400 160 fs_device mms EC:47:49:CF:53:C4;
#X obj 20 300 fs_drone mmrl 45;
#X obj 160 300 fs_pluck mmrl 57;
#X obj 300 300 fs_hit mmrl roll 300;
#X obj 300 330 fs_hit mmrl chop 1200;
#X obj 300 360 fs_hit mmrl wave 600;
#X obj 600 300 fs_drone mms 49;
#X obj 760 300 fs_pluck mms 61;
#X obj 20 420 tgl 18 1 empty empty drone 22 9 0 12 #fcfcfc #000000 #000000 1 1;
#X obj 160 420 tgl 18 1 empty empty pluck 22 9 0 12 #fcfcfc #000000 #000000 1 1;
#X obj 300 420 tgl 18 1 empty empty hits 22 9 0 12 #fcfcfc #000000 #000000 1 1;
#X obj 600 420 tgl 18 1 empty empty drone 22 9 0 12 #fcfcfc #000000 #000000 1 1;
#X obj 760 420 tgl 18 1 empty empty pluck 22 9 0 12 #fcfcfc #000000 #000000 1 1;
#X obj 20 460 *~ 0;
#X obj 160 460 *~ 0;
#X obj 300 460 *~ 0;
#X obj 600 460 *~ 0;
#X obj 760 460 *~ 0;
#X obj 400 560 hsl 160 18 0 1 0 1 empty empty master 0 -9 0 12 #fcfcfc #000000 #000000 7950 1;
#X obj 400 590 pack f 50;
#X obj 400 620 line~;
#X obj 300 560 *~;
#X obj 300 600 clip~ -0.9 0.9;
#X obj 300 650 dac~;
#X msg 20 560 \; pd dsp 1;
#X msg 20 600 \; pd dsp 0;
#X text 190 120 msg/s, f 6;
#X text 20 230 scale:, f 7;
#X msg 90 230 scale 0 2 4 7 9;
#X msg 240 230 scale 0 3 5 7 10;
#X msg 400 230 scale 0 2 4 5 7 9 11;
#X msg 580 230 scale 0 2 3 5 7 8 10;
#X text 90 255 major pent, f 11;
#X text 240 255 minor pent, f 11;
#X text 400 255 major, f 6;
#X text 580 255 minor, f 6;
#X text 600 380 mms, f 4;
#X text 20 380 mmrl, f 5;
